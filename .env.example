# Copy to .env (git-ignored) and change the secrets:   Copy-Item .env.example .env
# Read by scripts/*.ps1. The API itself reads appsettings*.json and environment variables
# (for example ConnectionStrings__Liwa, Jwt__SigningKey); run-dev.ps1 passes these values on.

# ---- PostgreSQL (installed locally; no Docker) ----
# Create the role and database once:  psql -h localhost -U postgres -f scripts/create-db.sql
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=liwa
POSTGRES_USER=liwa
# Development password set by scripts/create-db.sql. Use a strong one on any shared server.
POSTGRES_PASSWORD=liwa

# Integration tests: a role with CREATEDB; each run creates and drops liwa_test_xxxxxxxx.
# Set as an environment variable (not read from this file by the tests):
#   $env:LIWA_TEST_PG='Host=localhost;Port=5432;Username=liwa;Password=liwa'

# ---- API ----
# At least 32 characters. Generate one with:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SIGNING_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_LIFETIME_MINUTES=480

# Demo accounts (password Liwa#2027). Set to false for ANY real deployment.
DEMO_SEED_ENABLED=true

# ---- Sign in with your Liwa account (Microsoft Entra ID) ----
# Off until university IT registers the app and supplies these values. See docs/sso.md.
SSO_ENABLED=false
SSO_TENANT_ID=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Keep username/password sign-in next to SSO (demo accounts, emergency admin access).
SSO_LOCAL_SIGNIN_ENABLED=true
