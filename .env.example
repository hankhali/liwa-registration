# Copy to .env (git-ignored) and change the secrets:   Copy-Item .env.example .env
# Used by docker-compose.yml and scripts/*.ps1.

# ---- PostgreSQL ----
POSTGRES_DB=liwa
POSTGRES_USER=liwa
POSTGRES_PASSWORD=liwa_dev_password
# Host port for Postgres (container listens on 5432). 5433 avoids clashing with a local Postgres.
DB_HOST_PORT=5433

# ---- API ----
# At least 32 characters. Generate one with:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SIGNING_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_LIFETIME_MINUTES=480

# Demo accounts (password Liwa#2027). Set to false for ANY real deployment.
DEMO_SEED_ENABLED=true

# Sign-in attempts allowed per IP per minute. Raise temporarily only for automated
# screenshot runs against the Docker stack (they sign in ~24 times).
SIGNIN_PERMITS_PER_MINUTE=10

# Swagger UI at /api/swagger. Keep false outside development.
SWAGGER_ENABLED=false

# ---- Web ----
# Host port for the full app (nginx serves Angular and proxies /api).
WEB_HOST_PORT=8088
