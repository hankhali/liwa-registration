# Force LF everywhere, regardless of the contributor's OS
* text=auto eol=lf

*.ps1   text eol=lf
*.sh    text eol=lf
*.cs    text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.csv   text eol=lf
*.sln   text eol=lf
*.slnx  text eol=lf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.pdf   binary
