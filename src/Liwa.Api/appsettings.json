{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Liwa": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "liwa-registration",
    "Audience": "liwa-registration",
    "SigningKey": "",
    "LifetimeMinutes": 480
  },
  "Security": {
    "PasswordHashing": {
      "Iterations": 600000
    }
  },
  "RateLimiting": {
    "SignInPermitsPerMinute": 10
  },
  "DemoSeed": {
    "Enabled": false
  },
  "Swagger": {
    "Enabled": false
  }
}
