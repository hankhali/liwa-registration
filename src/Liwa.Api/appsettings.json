{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Liwa": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "liwa-registration",
    "Audience": "liwa-registration",
    "SigningKey": "",
    "LifetimeMinutes": 480
  },
  "Security": {
    "PasswordHashing": {
      "Iterations": 600000
    }
  },
  "RateLimiting": {
    "SignInPermitsPerMinute": 10
  },
  "DemoSeed": {
    "Enabled": false
  },
  "Swagger": {
    "Enabled": false
  },
  "Sso": {
    "Enabled": false,
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "LocalSignInEnabled": true
  },
  "CreditPolicy": {
    "Name": "Default credit policy (to confirm with the Registrar)",
    "RepeatGradeRule": "LatestCounts",
    "AllowInProgressPrerequisites": true,
    "NormalLoad": 15,
    "GraduatingStudentsExemptFromMinimum": true,
    "Rules": [
      {
        "Name": "Summer, on probation",
        "Season": "Summer",
        "OnProbation": true,
        "MinCredits": 0,
        "MaxCredits": 6
      },
      {
        "Name": "Summer",
        "Season": "Summer",
        "MinCredits": 0,
        "MaxCredits": 9
      },
      {
        "Name": "On academic probation",
        "OnProbation": true,
        "MinCredits": 9,
        "MaxCredits": 12
      },
      {
        "Name": "High GPA (3.50 and above)",
        "MinGpa": 3.5,
        "MinCredits": 12,
        "MaxCredits": 21
      },
      {
        "Name": "Standard full-time load",
        "MinCredits": 12,
        "MaxCredits": 18
      }
    ]
  }
}
